[Unit]
Description=fips-pubpki issuer: renews certificates halfway through their validity and re-publishes them
Documentation=https://github.com/fr34aky/fips-pub-pki
After=network-online.target fips.service
Wants=network-online.target

[Service]
Type=simple
# Not root: the system user fips-pubpki (install.md creates it), shared by
# both units so that the state directory has one owner.
User=fips-pubpki
Group=fips-pubpki
StateDirectory=fips-pubpki
ConfigurationDirectory=fips-pubpki
ExecStart=/usr/bin/fips-pubpki --config /etc/fips-pubpki/config.yaml ca renew --watch
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
